{
  "title": "OPC UA Home Example",
  "data": {
    "endpoint": "opc.tcp://127.0.0.1:4840",
    "security_policy": "None",
    "username": null,
    "password": null,
    "client_cert_path": null,
    "client_key_path": null,
    "server_cert_path": null,
    "client_key_password": null,
    "notify_enabled": true,
    "notify_service": "persistent_notification.create",
    "notify_title_prefix": "OPC-UA",
    "notify_keywords": ["alarm", "warning", "fault", "error", "smoke", "water"],
    "scan_interval": 2,
    "nodes": []
  },
  "options": {
    "scan_interval": 2,
    "nodes": [
      {
        "kind": "sensor",
        "name": "Living Room Temperature",
        "node_id": "ns=2;s=Home.LivingRoom.Temperature",
        "unit_of_measurement": "°C",
        "device_class": "temperature",
        "state_class": "measurement",
        "icon": "mdi:thermometer"
      },
      {
        "kind": "binary_sensor",
        "name": "Basement Water Alarm",
        "node_id": "ns=2;s=Home.Basement.WaterLeakDetected",
        "device_class": "moisture",
        "icon": "mdi:water-alert",
        "invert": false
      },
      {
        "kind": "switch",
        "name": "Garden Pump",
        "node_id": "ns=2;s=Home.Garden.Pump.Enabled",
        "icon": "mdi:water-pump",
        "invert": false
      },
      {
        "kind": "light",
        "name": "Living Room Main Light",
        "node_id": "ns=2;s=Home.LivingRoom.Light.Power",
        "icon": "mdi:ceiling-light",
        "invert": false,
        "brightness_node_id": "ns=2;s=Home.LivingRoom.Light.Brightness",
        "brightness_scale": 255,
        "color_temp_node_id": "ns=2;s=Home.LivingRoom.Light.ColorTemp",
        "color_temp_min_kelvin": 2000,
        "color_temp_max_kelvin": 6500,
        "hs_hue_node_id": "ns=2;s=Home.LivingRoom.Light.Hue",
        "hs_hue_scale": 360,
        "hs_saturation_node_id": "ns=2;s=Home.LivingRoom.Light.Saturation",
        "hs_saturation_scale": 100,
        "rgb_r_node_id": "ns=2;s=Home.LivingRoom.Light.RGB.R",
        "rgb_g_node_id": "ns=2;s=Home.LivingRoom.Light.RGB.G",
        "rgb_b_node_id": "ns=2;s=Home.LivingRoom.Light.RGB.B",
        "rgbw_r_node_id": "ns=2;s=Home.LivingRoom.Light.RGBW.R",
        "rgbw_g_node_id": "ns=2;s=Home.LivingRoom.Light.RGBW.G",
        "rgbw_b_node_id": "ns=2;s=Home.LivingRoom.Light.RGBW.B",
        "rgbw_w_node_id": "ns=2;s=Home.LivingRoom.Light.RGBW.W",
        "rgbww_r_node_id": "ns=2;s=Home.LivingRoom.Light.RGBWW.R",
        "rgbww_g_node_id": "ns=2;s=Home.LivingRoom.Light.RGBWW.G",
        "rgbww_b_node_id": "ns=2;s=Home.LivingRoom.Light.RGBWW.B",
        "rgbww_cw_node_id": "ns=2;s=Home.LivingRoom.Light.RGBWW.CW",
        "rgbww_ww_node_id": "ns=2;s=Home.LivingRoom.Light.RGBWW.WW",
        "rgb_scale": 255,
        "white_node_id": "ns=2;s=Home.LivingRoom.Light.White",
        "white_scale": 255,
        "xy_x_node_id": "ns=2;s=Home.LivingRoom.Light.XY.X",
        "xy_y_node_id": "ns=2;s=Home.LivingRoom.Light.XY.Y",
        "xy_scale": 1,
        "effect_node_id": "ns=2;s=Home.LivingRoom.Light.Effect",
        "effect_list": ["off", "reading", "movie", "party"],
        "transition_node_id": "ns=2;s=Home.LivingRoom.Light.Transition",
        "flash_node_id": "ns=2;s=Home.LivingRoom.Light.Flash"
      },
      {
        "kind": "button",
        "name": "Doorbell Chime Test",
        "node_id": "ns=2;s=Home.Entry.Doorbell.Test",
        "button_payload": true,
        "icon": "mdi:gesture-tap-button"
      },
      {
        "kind": "climate",
        "name": "Living Room Thermostat",
        "node_id": "ns=2;s=Home.LivingRoom.HVAC.CurrentTemperature",
        "target_node_id": "ns=2;s=Home.LivingRoom.HVAC.TargetTemperature",
        "hvac_mode_node_id": "ns=2;s=Home.LivingRoom.HVAC.Mode",
        "min_temp": 7,
        "max_temp": 35,
        "temp_step": 0.5,
        "icon": "mdi:thermostat"
      },
      {
        "kind": "cover",
        "name": "Patio Blinds",
        "node_id": "ns=2;s=Home.Patio.Blinds.Position",
        "target_node_id": "ns=2;s=Home.Patio.Blinds.Target",
        "set_position_node_id": "ns=2;s=Home.Patio.Blinds.SetPosition",
        "open_node_id": "ns=2;s=Home.Patio.Blinds.Open",
        "close_node_id": "ns=2;s=Home.Patio.Blinds.Close",
        "stop_node_id": "ns=2;s=Home.Patio.Blinds.Stop",
        "invert_position": false,
        "icon": "mdi:blinds"
      },
      {
        "kind": "date",
        "name": "Filter Replacement Date",
        "node_id": "ns=2;s=Home.Utility.FilterReplacementDate",
        "icon": "mdi:calendar"
      },
      {
        "kind": "datetime",
        "name": "Last Boiler Service",
        "node_id": "ns=2;s=Home.Utility.Boiler.LastServiceDateTime",
        "icon": "mdi:calendar-clock"
      },
      {
        "kind": "fan",
        "name": "Bathroom Ventilation Fan",
        "node_id": "ns=2;s=Home.Bathroom.Fan.On",
        "speed_node_id": "ns=2;s=Home.Bathroom.Fan.Speed",
        "invert": false,
        "icon": "mdi:fan"
      },
      {
        "kind": "notify",
        "name": "House Alert Notify",
        "node_id": "ns=2;s=Home.Alerts.Active",
        "message_node_id": "ns=2;s=Home.Alerts.Message",
        "title_node_id": "ns=2;s=Home.Alerts.Title",
        "icon": "mdi:message-alert"
      },
      {
        "kind": "number",
        "name": "EV Charger Current Limit",
        "node_id": "ns=2;s=Home.Garage.EVCharger.CurrentLimit",
        "number_min": 6,
        "number_max": 32,
        "number_step": 1,
        "unit_of_measurement": "A",
        "icon": "mdi:ev-station"
      },
      {
        "kind": "scene",
        "name": "Evening Scene",
        "node_id": "ns=2;s=Home.Scenes.Active",
        "scene_activate_value": "evening",
        "icon": "mdi:theme-light-dark"
      },
      {
        "kind": "select",
        "name": "House Mode",
        "node_id": "ns=2;s=Home.Mode",
        "select_options": ["home", "away", "night", "vacation"],
        "icon": "mdi:form-select"
      },
      {
        "kind": "text",
        "name": "Entry Display Message",
        "node_id": "ns=2;s=Home.Entry.DisplayMessage",
        "text_max": 255,
        "icon": "mdi:form-textbox"
      },
      {
        "kind": "time",
        "name": "Garden Irrigation Start",
        "node_id": "ns=2;s=Home.Garden.Irrigation.StartTime",
        "icon": "mdi:clock-outline"
      },
      {
        "kind": "weather",
        "name": "Home Outdoor Weather",
        "node_id": "ns=2;s=Home.Weather.Temperature",
        "humidity_node_id": "ns=2;s=Home.Weather.Humidity",
        "pressure_node_id": "ns=2;s=Home.Weather.Pressure",
        "wind_speed_node_id": "ns=2;s=Home.Weather.WindSpeed",
        "condition_node_id": "ns=2;s=Home.Weather.Condition",
        "icon": "mdi:weather-partly-cloudy"
      }
    ]
  }
}
